# Required first-party control-plane authentication (at least 32 random bytes)
TAWUN_JWT_SECRET=<generate-a-32-byte-or-longer-random-secret>

# Exact public origin and browser control-plane origins. Remote origins must use HTTPS.
TAWUN_PUBLIC_BASE_URL=http://localhost:8080
TAWUN_ALLOWED_ORIGINS=http://localhost:8080
TAWUN_MCP_ALLOWED_HOSTS=localhost:8080

# Stable Ed25519 artifact signer: base64-encoded 64-byte private key, never a seed.
TAWUN_ARTIFACT_SIGNING_KEY_ID=local-artifact-v1
TAWUN_ARTIFACT_SIGNING_PRIVATE_KEY=<base64-encoded-ed25519-private-key>
TAWUN_ARTIFACT_ROOT=./data/artifacts

# Relay sessions are HMAC-signed, one-use, and bound to these exact browser origins.
RELAY_SHARED_SECRET=<generate-a-32-byte-or-longer-random-secret>
RELAY_ALLOWED_ORIGINS=http://localhost:8080

# Durable local data. In Docker these should point inside /data.
APP_DB_PATH=./data/taawun.db
TAWUN_FINANCIAL_DB_PATH=./data/taawun-azoa.db

# Optional dedicated Shura signer. If omitted, the artifact signing key is used only as
# a local-development fallback. Configure a separate key in production.
# TAWUN_SHURA_ISSUER=https://app.example.com
# TAWUN_SHURA_SIGNING_KEY_ID=shura-v1
# TAWUN_SHURA_SIGNING_PRIVATE_KEY=<base64-encoded-ed25519-private-key>

# Optional one-time bootstrap administrator. All three values are required together.
# TAWUN_BOOTSTRAP_ADMIN_USERNAME=operator
# TAWUN_BOOTSTRAP_ADMIN_EMAIL=operator@example.com
# TAWUN_BOOTSTRAP_ADMIN_PASSWORD=<at-least-12-characters>
